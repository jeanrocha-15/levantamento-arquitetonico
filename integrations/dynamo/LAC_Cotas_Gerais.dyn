{
  "Uuid": "9c897253579b58889af271d0a41c942f",
  "IsCustomNode": false,
  "Description": "Cotas gerais e encadeadas com referências nativas de paredes.",
  "Name": "LAC_Cotas_Gerais",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "CoreNodeModels.Input.BoolSelector, CoreNodeModels",
      "Id": "edb5b33ece2f5a06807640934174d407",
      "NodeType": "BooleanInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "13bf5f79822654d290d18beaf0fa6ce8",
          "Name": "",
          "Description": "Executar",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ative para executar",
      "InputValue": false
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Id": "8d90fcca9a5f5c9cb92a021f3e516bcc",
      "NodeType": "PythonScriptNode",
      "Code": "\"\"\"Shared Dynamo PythonNet3 adapter; embedded in each graph at build time.\"\"\"\nimport math\nimport clr\nclr.AddReference('RevitAPI')\nclr.AddReference('RevitAPIUI')\nclr.AddReference('RevitServices')\nclr.AddReference('System.Windows.Forms')\nclr.AddReference('System.Drawing')\nfrom Autodesk.Revit import DB\nfrom Autodesk.Revit.UI.Selection import ObjectType\nfrom Autodesk.Revit.Exceptions import OperationCanceledException\nfrom RevitServices.Persistence import DocumentManager\nfrom RevitServices.Transactions import TransactionManager\nfrom System.Windows import Forms as WF\nfrom System.Drawing import Size, Point\n\ndoc=DocumentManager.Instance.CurrentDBDocument\nuidoc=DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\nview=doc.ActiveView\nFT=.3048\n\n\ndef name_of(element):\n    try:return element.Name\n    except Exception:\n        p=element.get_Parameter(DB.BuiltInParameter.SYMBOL_NAME_PARAM)\n        return p.AsString() if p else str(element.Id.Value)\n\n\ndef configure(title, fields):\n    form=WF.Form();form.Text=title;form.Width=620;form.Height=155+len(fields)*50\n    form.StartPosition=WF.FormStartPosition.CenterScreen;form.TopMost=True\n    form.FormBorderStyle=WF.FormBorderStyle.FixedDialog;form.MaximizeBox=False;form.MinimizeBox=False\n    controls={}\n    for index,(key,label,values,default) in enumerate(fields):\n        text=WF.Label();text.Text=label;text.Location=Point(12,15+index*50);text.Size=Size(575,18)\n        control=WF.ComboBox() if values is not None else WF.TextBox()\n        control.Location=Point(12,34+index*50);control.Size=Size(575,25)\n        if values is not None:\n            control.DropDownStyle=WF.ComboBoxStyle.DropDownList\n            for value in values:control.Items.Add(str(value))\n            control.SelectedIndex=values.index(default) if default in values else 0\n        else:control.Text=str(default)\n        controls[key]=control;form.Controls.Add(text);form.Controls.Add(control)\n    ok=WF.Button();ok.Text='Continuar';ok.DialogResult=WF.DialogResult.OK;ok.Location=Point(370,65+len(fields)*50)\n    cancel=WF.Button();cancel.Text='Cancelar';cancel.DialogResult=WF.DialogResult.Cancel;cancel.Location=Point(475,65+len(fields)*50)\n    form.Controls.Add(ok);form.Controls.Add(cancel);form.AcceptButton=ok;form.CancelButton=cancel\n    try:\n        if form.ShowDialog()!=WF.DialogResult.OK:raise OperationCanceledException()\n        return {key:control.Text for key,control in controls.items()}\n    finally:form.Dispose()\n\n\ndef number(text, low, high):\n    value=float(text.replace(',','.'))\n    if not math.isfinite(value) or not low<=value<=high:raise ValueError('Valor fora de {} a {}.'.format(low,high))\n    return value\n\n\ndef source_options():\n    result={'Projeto atual':None}\n    for link in DB.FilteredElementCollector(doc).OfClass(DB.RevitLinkInstance):\n        if link.GetLinkDocument() is not None and not link.IsHidden(view):\n            result['{} [{}]'.format(name_of(link),link.Id.Value)]=link\n    return result\n\n\ndef collect(source, link, category=None, klass=None):\n    collector=DB.FilteredElementCollector(doc,view.Id,link.Id) if link else DB.FilteredElementCollector(doc,view.Id)\n    if category is not None:collector=collector.OfCategory(category)\n    if klass is not None:collector=collector.OfClass(klass)\n    return list(collector.WhereElementIsNotElementType())\n\n\ndef require_plan():\n    if doc.IsFamilyDocument or not isinstance(view,DB.ViewPlan) or view.IsTemplate or not view.GenLevel:\n        raise ValueError('Abra uma planta de pavimento com nível associado.')\n    if abs(view.ViewDirection.Z)<.999999:raise ValueError('Somente plantas horizontais são suportadas.')\n    # End any idle Dynamo-managed transaction before native rollback groups.\n    TransactionManager.Instance.ForceCloseTransaction()\n\n\ndef within_crop(a,b):\n    if not view.CropBoxActive:return True\n    box=view.CropBox\n    for p in (a,b):\n        local=box.Transform.Inverse.OfPoint(p)\n        if not (box.Min.X<=local.X<=box.Max.X and box.Min.Y<=local.Y<=box.Max.Y):return False\n    return True\n\n\ndef finish(message):\n    WF.MessageBox.Show(message,'LAC · Dynamo')\n\n\ndef guarded(callback):\n    try:\n        require_plan()\n        return callback()\n    except OperationCanceledException:return {'status':'Cancelado pelo usuário; nenhuma operação pendente.'}\n    except Exception as error:\n        finish(str(error))\n        return {'status':'Erro','mensagem':str(error)}\n\nimport types\nALIGNMENT=.999999\nrevit=types.SimpleNamespace(doc=doc)\ndef faces_of(wall, view):\n    options = DB.Options()\n    options.ComputeReferences = True\n    options.IncludeNonVisibleObjects = False\n    native_view = getattr(view, 'native_view', view)\n    if native_view is not None:\n        options.View = native_view\n    else:\n        options.DetailLevel = DB.ViewDetailLevel.Fine\n    faces = []\n    for geometry in wall.get_Geometry(options):\n        if isinstance(geometry, DB.Solid):\n            for face in geometry.Faces:\n                if isinstance(face, DB.PlanarFace) and face.Reference:\n                    faces.append(face)\n    return faces\n\ndef edges_of(wall, view):\n    options = DB.Options()\n    options.ComputeReferences = True\n    options.IncludeNonVisibleObjects = False\n    native_view = getattr(view, 'native_view', view)\n    if native_view is not None:\n        options.View = native_view\n    else:\n        options.DetailLevel = DB.ViewDetailLevel.Fine\n    edges = []\n    for geometry in wall.get_Geometry(options):\n        if isinstance(geometry, DB.Solid):\n            edges.extend(list(geometry.Edges))\n    return edges\n\ndef endpoint_candidates(wall, view, curve, start, end, direction, faces):\n    alternatives = []\n    doc = getattr(wall, 'Document', revit.doc)\n\n    def valid(ref):\n        if ref is None:\n            return False\n        try:\n            if ref.ElementId != wall.Id:\n                return False\n            return bool(ref.ConvertToStableRepresentation(doc))\n        except Exception:\n            return False\n    try:\n        refs = [curve.GetEndPointReference(0), curve.GetEndPointReference(1)]\n        if all((valid(r) for r in refs)) and reference_key(doc, refs)[0] != reference_key(doc, refs)[1]:\n            alternatives.append((refs, project_to_view(start, view), project_to_view(end, view)))\n    except Exception:\n        pass\n    ends = [[], []]\n    near = max(wall.Width * 2, 0.01)\n    span = end.Subtract(start).DotProduct(direction)\n\n    def add(ref, point):\n        if not valid(ref):\n            return\n        t = point.Subtract(start).DotProduct(direction)\n        for index, target in enumerate((0, span)):\n            if abs(t - target) <= near and abs(t - target) < span / 2:\n                projected = project_to_view(start, view).Add(direction.Multiply(t))\n                ends[index].append((abs(t - target), ref, projected))\n    for face in faces:\n        if abs(face.FaceNormal.DotProduct(direction)) >= ALIGNMENT:\n            add(face.Reference, face.Origin)\n    try:\n        edges = edges_of(wall, view)\n    except Exception:\n        edges = []\n    for edge in edges:\n        try:\n            c = edge.AsCurve()\n            if not isinstance(c, DB.Line):\n                continue\n            a, b = (c.GetEndPoint(0), c.GetEndPoint(1))\n            axis = b.Subtract(a).Normalize()\n            if abs(axis.DotProduct(view.ViewDirection)) >= ALIGNMENT:\n                add(edge.Reference, a)\n            for index, point in enumerate((a, b)):\n                try:\n                    add(c.GetEndPointReference(index), point)\n                except Exception:\n                    pass\n        except Exception:\n            pass\n    for candidates in ends:\n        candidates.sort(key=lambda x: x[0])\n    seen = set((reference_key(doc, a[0]) for a in alternatives))\n    for first in ends[0][:6]:\n        for last in ends[1][:6]:\n            refs = [first[1], last[1]]\n            key = reference_key(doc, refs)\n            if key in seen or key[0] == key[1]:\n                continue\n            if last[2].Subtract(first[2]).DotProduct(direction) <= 0.0001:\n                continue\n            seen.add(key)\n            alternatives.append((refs, first[2], last[2]))\n    return alternatives[:20]\n\ndef reference_key(doc, refs):\n    return tuple(sorted((r.ConvertToStableRepresentation(doc) for r in refs)))\n\ndef rectangle(points, view, padding):\n    xs = [p.DotProduct(view.RightDirection) for p in points]\n    ys = [p.DotProduct(view.UpDirection) for p in points]\n    return (min(xs) - padding, min(ys) - padding, max(xs) + padding, max(ys) + padding)\n\ndef polygon_of_box(box):\n    return [(box[0], box[1]), (box[2], box[1]), (box[2], box[3]), (box[0], box[3])]\n\ndef overlaps(a, b):\n    for polygon in (a, b):\n        for i, p in enumerate(polygon):\n            q = polygon[(i + 1) % len(polygon)]\n            axis = (p[1] - q[1], q[0] - p[0])\n            if abs(axis[0]) + abs(axis[1]) < 1e-06:\n                continue\n            x = [point[0] * axis[0] + point[1] * axis[1] for point in a]\n            y = [point[0] * axis[0] + point[1] * axis[1] for point in b]\n            if max(x) <= min(y) or max(y) <= min(x):\n                return False\n    return True\n\ndef wall_footprint(wall, view):\n    if isinstance(wall.Location, DB.LocationCurve) and isinstance(wall.Location.Curve, DB.Line):\n        curve = wall.Location.Curve\n        a, b = (curve.GetEndPoint(0), curve.GetEndPoint(1))\n        n = view.ViewDirection.CrossProduct(b.Subtract(a).Normalize()).Normalize().Multiply(wall.Width / 2)\n        points = [a.Add(n), b.Add(n), b.Subtract(n), a.Subtract(n)]\n        return [(p.DotProduct(view.RightDirection), p.DotProduct(view.UpDirection)) for p in points]\n    return None\n\ndef box_rectangle(box, view):\n    points = [box.Transform.OfPoint(DB.XYZ(x, y, z)) for x in (box.Min.X, box.Max.X) for y in (box.Min.Y, box.Max.Y) for z in (box.Min.Z, box.Max.Z)]\n    return rectangle(points, view, 0)\n\ndef project_to_view(point, view):\n    return point.Subtract(view.ViewDirection.Multiply(point.Subtract(view.Origin).DotProduct(view.ViewDirection)))\n\ndef dimension_specs(wall, view, mode, offset):\n    location = wall.Location\n    if not isinstance(location, DB.LocationCurve) or not isinstance(location.Curve, DB.Line):\n        raise ValueError('Parede curva ou sem eixo reto: nao suportada.')\n    curve = location.Curve\n    start, end = (curve.GetEndPoint(0), curve.GetEndPoint(1))\n    direction = end.Subtract(start).Normalize()\n    if abs(direction.DotProduct(view.ViewDirection)) > 1e-06:\n        raise ValueError('Eixo fora do plano da vista ativa.')\n    normal = view.ViewDirection.CrossProduct(direction).Normalize()\n    if normal.DotProduct(wall.Orientation) < 0:\n        normal = normal.Negate()\n    faces = faces_of(wall, view)\n    specs, errors = ([], [])\n    if mode != 'Espessura':\n        alternatives = endpoint_candidates(wall, view, curve, start, end, direction, faces)\n        if not alternatives:\n            errors.append('Comprimento: eixo sem referencias nativas e nenhuma face/aresta referenciavel proxima das extremidades na vista.')\n        for refs, p, q in alternatives:\n            specs.append(('comprimento', refs, p, q, normal, wall.Width / 2 + offset))\n    if mode != 'Comprimento':\n        try:\n            valid = {f.Reference.ConvertToStableRepresentation(getattr(wall, 'Document', revit.doc)) for f in faces}\n            sides = []\n            for side in (DB.ShellLayerType.Interior, DB.ShellLayerType.Exterior):\n                candidates = []\n                for ref in DB.HostObjectUtils.GetSideFaces(wall, side):\n                    face = wall.GetGeometryObjectFromReference(ref)\n                    if isinstance(face, DB.PlanarFace) and abs(face.FaceNormal.DotProduct(normal)) >= ALIGNMENT and (ref.ConvertToStableRepresentation(getattr(wall, 'Document', revit.doc)) in valid):\n                        candidates.append((face, ref))\n                if not candidates:\n                    raise ValueError('Face de acabamento sem referencia valida na vista.')\n                sides.append(max(candidates, key=lambda pair: pair[0].Area))\n            a, b = [pair[0].Origin.DotProduct(normal) for pair in sides]\n            if abs(b - a) < 0.0001:\n                raise ValueError('Faces coincidentes.')\n            base = project_to_view(start, view)\n            p = base.Add(normal.Multiply(a - start.DotProduct(normal)))\n            q = base.Add(normal.Multiply(b - start.DotProduct(normal)))\n            specs.append(('espessura', [pair[1] for pair in sides], p, q, direction.Negate(), offset))\n        except Exception as error:\n            errors.append('Espessura: {0}'.format(error))\n    return (specs, errors)\n\"\"\"General and chained native dimensions, using LAC's existing reference search.\"\"\"\ndef dimension_main():\n    sources=source_options()\n    dimension_types={'Padrão do Revit':None}\n    for kind in DB.FilteredElementCollector(doc).OfClass(DB.DimensionType):\n        if kind.StyleType==DB.DimensionStyleType.Linear:\n            dimension_types['{} [{}]'.format(name_of(kind),kind.Id.Value)]=kind\n    config=configure('Cotas gerais automáticas',[\n        ('source','Origem das paredes',list(sources),'Projeto atual'),\n        ('scope','Paredes a cotar',['Todas as paredes visíveis','Selecionar paredes'],'Todas as paredes visíveis'),\n        ('mode','Composição',['Todas as paredes','Externas + trechos principais'],'Todas as paredes'),\n        ('minimum','Trecho principal mínimo (m), para a segunda opção',None,'1,00'),\n        ('style','Tipo de cota',list(dimension_types),'Padrão do Revit'),\n        ('offset','Afastamento no papel (mm)',None,'8'),\n    ])\n    link=sources[config['source']];source=link.GetLinkDocument() if link else doc\n    transform=link.GetTotalTransform() if link else DB.Transform.Identity\n    walls=collect(source,link,klass=DB.Wall)\n    if config['scope']=='Selecionar paredes':\n        references=uidoc.Selection.PickObjects(ObjectType.LinkedElement if link else ObjectType.Element,'Selecione as paredes e conclua a seleção')\n        selected={int(r.LinkedElementId.Value if link else r.ElementId.Value) for r in references if not link or r.ElementId==link.Id}\n        walls=[w for w in walls if int(w.Id.Value) in selected]\n    if len(walls)<2:raise ValueError('Selecione pelo menos duas paredes visíveis da origem escolhida.')\n    offset=number(config['offset'],3,50)/1000*view.Scale/FT\n    minimum_run=number(config['minimum'],.1,50)/FT\n    dimension_type=dimension_types[config['style']]\n    warnings=[];directions={};points=[];geometries=[]\n    class LocalView:\n        native_view=None\n        def __init__(self):\n            inverse=transform.Inverse\n            self.Origin=inverse.OfPoint(view.Origin)\n            self.ViewDirection=inverse.OfVector(view.ViewDirection).Normalize()\n            self.RightDirection=inverse.OfVector(view.RightDirection).Normalize()\n            self.UpDirection=inverse.OfVector(view.UpDirection).Normalize()\n    local=LocalView() if link else view\n    for wall in walls:\n        try:\n            curve=wall.Location.Curve\n            if not isinstance(curve,DB.Line):raise ValueError('parede curva não suportada')\n            a,b=[transform.OfPoint(curve.GetEndPoint(i)) for i in (0,1)]\n            delta=b.Subtract(a).Normalize()\n            if abs(delta.Z)>.000001:raise ValueError('eixo fora do plano da planta')\n            angle=math.atan2(delta.DotProduct(view.UpDirection),delta.DotProduct(view.RightDirection))%math.pi\n            key=round(angle,7)\n            directions[key]=view.RightDirection.Multiply(math.cos(angle)).Add(view.UpDirection.Multiply(math.sin(angle)))\n            points.extend([a,b])\n            faces=faces_of(wall,local)\n            geometries.append((wall,curve,faces))\n        except Exception as error:warnings.append('Parede {}: {}'.format(wall.Id.Value,error))\n    if not geometries:raise ValueError('Nenhuma parede reta referenciável.')\n    existing=set()\n    for dim in DB.FilteredElementCollector(doc,view.Id).OfClass(DB.Dimension):\n        try:existing.add(reference_key(doc,list(dim.References)))\n        except Exception:pass\n    group=DB.TransactionGroup(doc,'LAC · Dynamo · Cotas gerais');group.Start()\n    created=[];skipped=0\n    try:\n        if config['mode']=='Todas as paredes':\n            centre=DB.XYZ(sum(p.X for p in points)/len(points),sum(p.Y for p in points)/len(points),sum(p.Z for p in points)/len(points))\n            occupied=[]\n            for wall,curve,faces in geometries:\n                footprint=wall_footprint(wall,local)\n                if footprint:\n                    world=[]\n                    for x,y in footprint:\n                        p=local.RightDirection.Multiply(x).Add(local.UpDirection.Multiply(y))\n                        p=transform.OfPoint(p)\n                        world.append((p.DotProduct(view.RightDirection),p.DotProduct(view.UpDirection)))\n                    occupied.append(world)\n            for dim in DB.FilteredElementCollector(doc,view.Id).OfClass(DB.Dimension):\n                box=dim.get_BoundingBox(view)\n                if box:occupied.append(polygon_of_box(box_rectangle(box,view)))\n            for wall,curve,faces in geometries:\n                try:specs,errors=dimension_specs(wall,local,'Comprimento',offset)\n                except Exception as error:\n                    warnings.append('Parede {}: {}'.format(wall.Id.Value,error));continue\n                warnings.extend('Parede {}: {}'.format(wall.Id.Value,e) for e in errors)\n                accepted=False\n                for kind,refs,p,q,away,distance in specs:\n                    try:\n                        if link:refs=[r.CreateLinkReference(link) for r in refs]\n                        key=reference_key(doc,refs)\n                    except Exception:continue\n                    if key in existing:skipped+=1;accepted=True;break\n                    p=project_to_view(transform.OfPoint(p),view);q=project_to_view(transform.OfPoint(q),view)\n                    away=transform.OfVector(away).Normalize()\n                    if away.DotProduct(p.Add(q).Multiply(.5).Subtract(centre))<0:away=away.Negate()\n                    for lane in range(8):\n                        shift=away.Multiply(distance+lane*offset)\n                        a,b=p.Add(shift),q.Add(shift)\n                        if not within_crop(a,b):continue\n                        area=polygon_of_box(rectangle([a,b],view,offset*.25))\n                        if any(overlaps(area,box) for box in occupied):continue\n                        tx=DB.Transaction(doc,'Cota associativa de parede');tx.Start()\n                        try:\n                            array=DB.ReferenceArray()\n                            for ref in refs:array.Append(ref)\n                            line=DB.Line.CreateBound(a,b)\n                            dim=doc.Create.NewDimension(view,line,array,dimension_type) if dimension_type else doc.Create.NewDimension(view,line,array)\n                            doc.Regenerate()\n                            if dim is None or not dim.AreReferencesAvailable or dim.Value is None or abs(dim.Value-p.DistanceTo(q))>.001/FT:\n                                raise ValueError('Referência não mede o comprimento proposto.')\n                            if tx.Commit()!=DB.TransactionStatus.Committed:raise ValueError('Transação não confirmada.')\n                            created.append(int(dim.Id.Value));existing.add(key);occupied.append(area);accepted=True;break\n                        except Exception:\n                            if tx.GetStatus()==DB.TransactionStatus.Started:tx.RollBack()\n                        finally:tx.Dispose()\n                    if accepted:break\n                if not accepted:warnings.append('Parede {}: sem referências aceitas ou sem espaço livre nas 8 faixas próximas.'.format(wall.Id.Value))\n            directions={}\n        for angle,direction in sorted(directions.items()):\n            normal=view.ViewDirection.CrossProduct(direction).Normalize();candidates=[]\n            def add(ref,point,priority):\n                try:\n                    if ref is None:return\n                    converted=ref.CreateLinkReference(link) if link else ref\n                    converted.ConvertToStableRepresentation(doc)\n                    world=transform.OfPoint(point)\n                    candidates.append((world.DotProduct(direction),priority,converted))\n                except Exception:pass\n            for wall,curve,faces in geometries:\n                for face in faces:\n                    if abs(transform.OfVector(face.FaceNormal).DotProduct(direction))>=ALIGNMENT:\n                        add(face.Reference,face.Origin,0)\n                axis=curve.GetEndPoint(1).Subtract(curve.GetEndPoint(0)).Normalize()\n                if abs(transform.OfVector(axis).DotProduct(direction))>=ALIGNMENT:\n                    alternatives=endpoint_candidates(wall,local,curve,curve.GetEndPoint(0),curve.GetEndPoint(1),axis,faces)\n                    for refs,p,q in alternatives:\n                        for ref,point in zip(refs,(p,q)):add(ref,point,1)\n            candidates.sort(key=lambda item:(item[0],item[1]))\n            stations=[]\n            for item in candidates:\n                if not stations or abs(item[0]-stations[-1][0][0])>.001/FT:stations.append([item])\n                else:stations[-1].append(item)\n            if len(stations)<2:\n                warnings.append('Direção {:.1f}°: sem duas referências externas válidas.'.format(math.degrees(angle)));continue\n            # Retain both extrema; intermediate stations only at meaningful spacing.\n            major=[stations[0]]\n            for station in stations[1:-1]:\n                if station[0][0]-major[-1][0][0]>=minimum_run and stations[-1][0][0]-station[0][0]>=minimum_run:\n                    major.append(station)\n            stations=major+[stations[-1]]\n            minimum=min(p.DotProduct(normal) for p in points)-max(w.Width for w,_,_ in geometries)/2\n            # Separate lanes outside the entire selected assembly.\n            modes=['encadeada','geral'] if len(stations)>2 else ['geral']\n            for lane,mode in enumerate(modes):\n                selected_stations=stations if mode=='encadeada' else [stations[0],stations[-1]]\n                success=False;failures=[]\n                for attempt in range(6):\n                    chosen=[station[min(attempt,len(station)-1)] for station in selected_stations]\n                    refs=[s[2] for s in chosen];key=reference_key(doc,refs)\n                    if key in existing:skipped+=1;success=True;break\n                    p=view.Origin.Add(direction.Multiply(chosen[0][0]-view.Origin.DotProduct(direction))).Add(normal.Multiply(minimum-view.Origin.DotProduct(normal)-(lane+1)*offset))\n                    q=p.Add(direction.Multiply(chosen[-1][0]-chosen[0][0]))\n                    if not within_crop(p,q):\n                        failures.append('cota fora do recorte; amplie/desative o recorte da planta');continue\n                    tx=DB.Transaction(doc,'Cota geral associativa');tx.Start()\n                    try:\n                        array=DB.ReferenceArray()\n                        for ref in refs:array.Append(ref)\n                        line=DB.Line.CreateBound(p,q)\n                        dim=doc.Create.NewDimension(view,line,array,dimension_type) if dimension_type else doc.Create.NewDimension(view,line,array)\n                        doc.Regenerate()\n                        if dim is None or not dim.AreReferencesAvailable:raise ValueError('referências rejeitadas')\n                        measured=sum(seg.Value for seg in dim.Segments) if dim.NumberOfSegments>0 else dim.Value\n                        if measured is None or abs(measured-(chosen[-1][0]-chosen[0][0]))>.001/FT:\n                            raise ValueError('medida das referências difere da extensão geométrica')\n                        if tx.Commit()!=DB.TransactionStatus.Committed:raise ValueError('transação não confirmada')\n                        created.append(int(dim.Id.Value));existing.add(key);success=True;break\n                    except Exception as error:\n                        if tx.GetStatus()==DB.TransactionStatus.Started:tx.RollBack()\n                        failures.append(str(error))\n                    finally:tx.Dispose()\n                if not success:warnings.append('{:.1f}° / {}: {}'.format(math.degrees(angle),mode,'; '.join(sorted(set(failures)))))\n        if group.Assimilate()!=DB.TransactionStatus.Committed:raise ValueError('Grupo de cotas não confirmado.')\n    except Exception:\n        if group.GetStatus()==DB.TransactionStatus.Started:group.RollBack()\n        raise\n    finally:group.Dispose()\n    result={'cotas_criadas':created,'já_existentes':skipped,'avisos':warnings,'origem':config['source']}\n    finish('{} cotas criadas; {} existentes; {} avisos. Detalhes na saída do nó.'.format(len(created),skipped,len(warnings)))\n    return result\n\n\nOUT=guarded(dimension_main) if IN[0] else 'Ative Executar e clique Executar no modo Manual.'\n",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Inputs": [
        {
          "Id": "c6a34f297d8852f69d9bd2debeeea6de",
          "Name": "IN[0]",
          "Description": "Executar",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "b44b4cf6e61e57699e595a0600e4d25f",
